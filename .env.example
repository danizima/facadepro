# Production origin, without a path. The proxy must terminate HTTPS.
PUBLIC_URL=https://facadepro.ru
NODE_ENV=production
PORT=8080
DATA_DIR=/data
# Enable only behind your trusted reverse proxy.
TRUST_PROXY=1
# SMTP: configure on the server, never commit credentials.
# Both implicit TLS (465) and required STARTTLS (587) are supported.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
LEAD_TO=office@facadepro.ru
